# Copy this file to "keystore.properties" (same folder, repo root) and fill in your
# own values. keystore.properties is git-ignored and must NEVER be committed.
#
# Generate a keystore first, e.g. from the repo root:
#   keytool -genkey -v -keystore nyaa-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias nyaa
#
# storeFile is resolved relative to the repo root (rootProject.file), so if the
# keystore sits at the repo root just use its file name.

storeFile=nyaa-release.jks
storePassword=CHANGE_ME
keyAlias=nyaa
keyPassword=CHANGE_ME
